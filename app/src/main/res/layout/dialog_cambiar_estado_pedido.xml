<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:backgroundTint="#0F172A"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Cambiar estado del pedido"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCerrarDialogEstado"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:src="@drawable/ic_close"
            app:tint="#94A3B8" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="16dp"
        android:background="#1E293B" />

    <!-- Radio Group for states -->
    <RadioGroup
        android:id="@+id/rgEstadosPedido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Pendiente -->
        <RadioButton
            android:id="@+id/rbPendiente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_dashboard_card"
            android:backgroundTint="#111827"
            android:buttonTint="#2563EB"
            android:padding="16dp"
            android:text="Pendiente\nEl pedido ha sido creado y está pendiente de ser procesado"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:buttonCompat="@null" />

        <!-- Aceptado -->
        <RadioButton
            android:id="@+id/rbAceptado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_dashboard_card"
            android:backgroundTint="#111827"
            android:buttonTint="#2563EB"
            android:padding="16dp"
            android:text="Aceptado\nEl pedido ha sido aceptado y está en preparación"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:buttonCompat="@null" />

        <!-- En camino -->
        <RadioButton
            android:id="@+id/rbEnCamino"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_dashboard_card"
            android:backgroundTint="#111827"
            android:buttonTint="#2563EB"
            android:padding="16dp"
            android:text="En camino\nEl pedido está en proceso de entrega"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:buttonCompat="@null" />

        <!-- Entregado -->
        <RadioButton
            android:id="@+id/rbEntregado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_dashboard_card"
            android:backgroundTint="#111827"
            android:buttonTint="#2563EB"
            android:padding="16dp"
            android:text="Entregado\nEl pedido ha sido entregado al cliente"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:buttonCompat="@null" />

        <!-- Cancelado -->
        <RadioButton
            android:id="@+id/rbCancelado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_dashboard_card"
            android:backgroundTint="#111827"
            android:buttonTint="#2563EB"
            android:padding="16dp"
            android:text="Cancelado\nEl pedido ha sido cancelado"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:buttonCompat="@null" />

    </RadioGroup>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarDialog"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:backgroundTint="#1E293B"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActualizarEstadoDialog"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:backgroundTint="#2563EB"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Actualizar estado"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>