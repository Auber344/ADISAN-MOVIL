<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DashboardActivity">

    <!-- Contenido Principal Dashboard -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#060A12">

        <!-- ScrollView principal para diseño totalmente responsive -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="28dp">

                <!-- 1. ENCABEZADO SUPERIOR EMPRESARIAL -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp">

                    <!-- Botón Menú Hamburguesa Naranja (Top Izquierda) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnMenuHamburguesa"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="12dp"
                        app:cardBackgroundColor="#F97316"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="Abrir Menú"
                            android:src="@drawable/ic_menu"
                            app:tint="@color/white" />
                    </com.google.android.material.card.MaterialCardView>



                    <!-- Avatar Circular Azul -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardAvatarContainer"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        app:cardBackgroundColor="#2563EB"
                        app:cardCornerRadius="21dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/btnAvatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Avatar"
                                android:padding="10dp"
                                android:src="@drawable/ic_user"
                                app:tint="@color/white" />

                            <TextView
                                android:id="@+id/tvAvatarInitial"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="A"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Botón de Notificaciones -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="10dp"
                        android:layout_toStartOf="@id/cardAvatarContainer"
                        app:cardBackgroundColor="#121824"
                        app:cardCornerRadius="21dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#1E293B"
                        app:strokeWidth="1dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/btnNotifications"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="Notificaciones"
                                android:src="@drawable/ic_notifications"
                                app:tint="@color/white" />

                            <!-- Indicador de Notificación activa (Rojo) -->
                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_gravity="top|end"
                                android:layout_marginTop="9dp"
                                android:layout_marginEnd="9dp"
                                android:background="@drawable/ic_warning"
                                android:backgroundTint="#EF4444" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                </RelativeLayout>

                <!-- GREETING Y FECHA DINÁMICA (Badge superior derecho) -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hola, admin 👋"
                            android:textColor="@color/white"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSubGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="¿Qué deseas hacer hoy?"
                            android:textColor="@color/login_text_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Fecha Badge Estilo Referencia -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        app:cardBackgroundColor="#121824"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#1E293B"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginEnd="6dp"
                                android:src="@drawable/ic_truck"
                                app:tint="@color/login_text_muted" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2 Oct 2026"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </RelativeLayout>

                <!-- BANNER PRINCIPAL (Tu negocio en movimiento) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    app:cardBackgroundColor="#0F172A"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp"
                    app:strokeColor="#1E3A8A"
                    app:strokeWidth="1dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="200dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:lineSpacingExtra="-2dp"
                                android:text="Tu negocio\nen movimiento"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:lineSpacingExtra="1dp"
                                android:text="Productos, pedidos y entregas siempre bajo control."
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />

                            <!-- Puntos indicadores -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="16dp"
                                    android:layout_height="4dp"
                                    android:layout_marginEnd="4dp"
                                    android:background="@drawable/bg_login_button" />

                                <View
                                    android:layout_width="6dp"
                                    android:layout_height="4dp"
                                    android:layout_marginEnd="4dp"
                                    android:background="#334155" />

                                <View
                                    android:layout_width="6dp"
                                    android:layout_height="4dp"
                                    android:background="#334155" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Imagen Camión / Gráfico de Referencia -->
                        <ImageView
                            android:layout_width="140dp"
                            android:layout_height="100dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:contentDescription="Camión"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_truck"
                            app:tint="#3B82F6" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginEnd="8dp"
                            android:layout_marginBottom="8dp"
                            app:cardBackgroundColor="#2563EB"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/white" />
                        </com.google.android.material.card.MaterialCardView>

                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. RESUMEN PRINCIPAL - METRICAS TARJETAS (GRID 2 COLUMNAS) -->

                <!-- Fila 1: Productos (cardProductos) y Inventario (cardStockBajo) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:orientation="horizontal">

                    <!-- Card 1: Productos -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardProductos"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#101725"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp"
                        app:strokeColor="#1E293B"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    app:cardBackgroundColor="#0D2247"
                                    app:cardCornerRadius="14dp"
                                    app:cardElevation="0dp"
                                    app:strokeWidth="0dp">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_box"
                                        app:tint="#3B82F6" />
                                </com.google.android.material.card.MaterialCardView>

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="#64748B" />
                            </RelativeLayout>

                            <TextView
                                android:id="@+id/tvValProductos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="12"
                                android:textColor="@color/white"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Productos"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Gestiona tu catálogo"
                                android:textColor="#64748B"
                                android:textSize="11sp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 2: Inventario -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardStockBajo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#101725"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp"
                        app:strokeColor="#1E293B"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    app:cardBackgroundColor="#062E29"
                                    app:cardCornerRadius="14dp"
                                    app:cardElevation="0dp"
                                    app:strokeWidth="0dp">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_chart_growth"
                                        app:tint="#10B981" />
                                </com.google.android.material.card.MaterialCardView>

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="#64748B" />
                            </RelativeLayout>

                            <TextView
                                android:id="@+id/tvValStockBajo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="0"
                                android:textColor="@color/white"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Inventario"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Control de stock"
                                android:textColor="#64748B"
                                android:textSize="11sp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Fila 2: Pedidos (cardPedidos) y Compras (cardEnCamino) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:orientation="horizontal">

                    <!-- Card 3: Pedidos -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPedidos"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#101725"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp"
                        app:strokeColor="#1E293B"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    app:cardBackgroundColor="#3D230C"
                                    app:cardCornerRadius="14dp"
                                    app:cardElevation="0dp"
                                    app:strokeWidth="0dp">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_shopping_cart"
                                        app:tint="#F59E0B" />
                                </com.google.android.material.card.MaterialCardView>

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="#64748B" />
                            </RelativeLayout>

                            <TextView
                                android:id="@+id/tvValPedidos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="8"
                                android:textColor="@color/white"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Pedidos"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Historial y catálogo"
                                android:textColor="#64748B"
                                android:textSize="11sp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 4: Compras -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardEnCamino"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#101725"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp"
                        app:strokeColor="#1E293B"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    app:cardBackgroundColor="#3B151C"
                                    app:cardCornerRadius="14dp"
                                    app:cardElevation="0dp"
                                    app:strokeWidth="0dp">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_truck"
                                        app:tint="#EF4444" />
                                </com.google.android.material.card.MaterialCardView>

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="#64748B" />
                            </RelativeLayout>

                            <TextView
                                android:id="@+id/tvValEnCamino"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="0"
                                android:textColor="@color/white"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Compras"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Registra compras"
                                android:textColor="#64748B"
                                android:textSize="11sp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Fila 3: Ofertas (cardQuickOfertas) y Usuarios (cardUsuarios) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal">

                    <!-- Card 5: Ofertas -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardQuickOfertas"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#101725"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp"
                        app:strokeColor="#1E293B"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    app:cardBackgroundColor="#241445"
                                    app:cardCornerRadius="14dp"
                                    app:cardElevation="0dp"
                                    app:strokeWidth="0dp">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_tag"
                                        app:tint="#8B5CF6" />
                                </com.google.android.material.card.MaterialCardView>

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="#64748B" />
                            </RelativeLayout>

                            <TextView
                                android:id="@+id/tvValOfertas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="0"
                                android:textColor="@color/white"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Ofertas"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Crea y gestiona"
                                android:textColor="#64748B"
                                android:textSize="11sp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 6: Reportes financieros -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardReportesFinancieros"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#101725"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp"
                        app:strokeColor="#1E293B"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    app:cardBackgroundColor="#062E29"
                                    app:cardCornerRadius="14dp"
                                    app:cardElevation="0dp"
                                    app:strokeWidth="0dp">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_chart_growth"
                                        app:tint="#10B981" />
                                </com.google.android.material.card.MaterialCardView>

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="#64748B" />
                            </RelativeLayout>

                            <TextView
                                android:id="@+id/tvValReportes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="S/"
                                android:textColor="@color/white"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Reportes financieros"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Consulta ingresos y ganancias"
                                android:textColor="#64748B"
                                android:textSize="11sp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Hidden views for existing IDs to ensure 100% logic safety -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/tvValUsuarios" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvValVentas" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvTotalVendido" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvAlertStockBajoText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvAlertEnCaminoText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <com.google.android.material.card.MaterialCardView android:id="@+id/cardUsuarios" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <com.google.android.material.card.MaterialCardView android:id="@+id/cardVentas" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <com.google.android.material.card.MaterialCardView android:id="@+id/cardQuickProductos" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <com.google.android.material.card.MaterialCardView android:id="@+id/cardQuickPedidos" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <com.google.android.material.card.MaterialCardView android:id="@+id/cardQuickProveedores" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- 6. NAVEGACIÓN INFERIOR DE ALTA DEFINICIÓN (DARK THEME) -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#101725"
            app:elevation="12dp"
            app:itemIconTint="@color/bottom_nav_dark_colors"
            app:itemRippleColor="#1F0084FF"
            app:itemTextColor="@color/bottom_nav_dark_colors"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:menu="@menu/bottom_nav_menu" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- PANEL NAVEGACIÓN LATERAL (SIDEBAR DRAWER) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationViewSidebar"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#060A12">

        <include layout="@layout/layout_sidebar_dashboard" />

    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
