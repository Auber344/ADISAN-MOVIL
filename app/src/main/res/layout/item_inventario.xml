<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#101725"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeColor="#1E293B"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardIconInv"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerVertical="true"
                app:cardBackgroundColor="#0D2247"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="Producto"
                    android:src="@drawable/ic_box"
                    app:tint="#3B82F6" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toStartOf="@id/tvEstadoStock"
                android:layout_toEndOf="@id/cardIconInv"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNombreProductoInventario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bolt"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCategoriaInventario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="#0D2247"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="BEBIDAS"
                    android:textColor="#3B82F6"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Badge de Estado del Stock -->
            <TextView
                android:id="@+id/tvEstadoStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="#062E29"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Stock suficiente"
                android:textColor="#10B981"
                android:textSize="11sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#1E293B" />

        <!-- Stock en Unidades y Desglose de Paquetes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Stock Actual -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStockUnidades"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="120 un."
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Stock actual"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Desglose de Paquetes -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDesglosePaquetes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 paq. + 0 un."
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Desglose"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Chevron / Botón Ajuste -->
            <ImageView
                android:id="@+id/btnAjustarStock"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Ajustar"
                android:src="@drawable/ic_chevron_right"
                app:tint="#94A3B8" />
        </LinearLayout>

        <!-- Oculto btnVerMovimientos para compatibilidad si InventarioAdapter lo busca -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerMovimientos"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
