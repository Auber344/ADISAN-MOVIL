<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#101725"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#1E293B"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Icono Izquierda -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIconMovFin"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="#062E29"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivIconMovFin"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Icono Movimiento"
                android:src="@drawable/ic_shopping_cart"
                app:tint="#10B981" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Bloque Central -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toStartOf="@id/layoutDerechaMovFin"
            android:layout_toEndOf="@id/cardIconMovFin"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitleMovFin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Venta #0012"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitleMovFin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Venta registrada"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDateMovFin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Hoy, 10:24"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Bloque Derecha: Monto, Badge y Opciones -->
        <LinearLayout
            android:id="@+id/layoutDerechaMovFin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="end"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAmountMovFin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S/ 320.00"
                    android:textColor="#10B981"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBadgeMovFin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#062E29"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Venta"
                    android:textColor="#10B981"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivMenuMovFin"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:contentDescription="Opciones"
                android:src="@drawable/ic_more"
                app:tint="#475569" />

        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
