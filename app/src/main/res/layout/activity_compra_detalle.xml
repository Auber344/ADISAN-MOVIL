<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060A12"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".CompraDetalleActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="36dp">

        <!-- Header Superior -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerBarDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#060A12"
            android:paddingHorizontal="20dp"
            android:paddingTop="36dp"
            android:paddingBottom="14dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnVolverDetalleCompra"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volver"
                android:padding="6dp"
                android:rotation="180"
                android:src="@drawable/ic_chevron_right"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Detalle de compra"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnVolverDetalleCompra"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Tarjeta Superior: ID, Fecha, Estado -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHeaderCompra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#101725"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="#1E293B"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/headerBarDetalle">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardIconHeader"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_centerVertical="true"
                    app:cardBackgroundColor="#3D230C"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="Icono Compra"
                        android:src="@drawable/ic_shopping_cart"
                        app:tint="#F59E0B" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_toStartOf="@id/tvDetalleEstadoCompra"
                    android:layout_toEndOf="@id/cardIconHeader"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDetalleIdCompra"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Compra #12"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetalleFechaCompra"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="03 Oct 2026 · 10:25 a. m."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDetalleEstadoCompra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="#062E29"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Completada"
                    android:textColor="#10B981"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 2: Información general -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInfoGeneralCompra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#101725"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="#1E293B"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/cardHeaderCompra">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="Información general"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Proveedor -->
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Proveedor" android:textColor="#94A3B8" android:textSize="13sp" />
                    <TextView id="@+id/tvDetalleProveedor" android:id="@+id/tvDetalleProveedor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="SASH SAC" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />
                </RelativeLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E293B" android:layout_marginBottom="10dp" />

                <!-- Total -->
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total" android:textColor="#94A3B8" android:textSize="13sp" />
                    <TextView id="@+id/tvDetalleTotal" android:id="@+id/tvDetalleTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="S/ 150.00" android:textColor="#F97316" android:textSize="14sp" android:textStyle="bold" />
                </RelativeLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E293B" android:layout_marginBottom="10dp" />

                <!-- Estado -->
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Estado" android:textColor="#94A3B8" android:textSize="13sp" />
                    <TextView id="@+id/tvDetalleEstadoInfo" android:id="@+id/tvDetalleEstadoInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="Completada" android:textColor="#10B981" android:textSize="13sp" android:textStyle="bold" />
                </RelativeLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E293B" android:layout_marginBottom="10dp" />

                <!-- Observación -->
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Observación" android:textColor="#94A3B8" android:textSize="13sp" />
                    <TextView id="@+id/tvDetalleObservacion" android:id="@+id/tvDetalleObservacion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="-" android:textColor="@color/white" android:textSize="13sp" />
                </RelativeLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sección: Productos Adquiridos -->
        <TextView
            android:id="@+id/lblProductosAdquiridos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="Productos adquiridos"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/cardInfoGeneralCompra"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- RecyclerView para los items de la compra -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDetalleCompraItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/lblProductosAdquiridos" />

        <!-- Card 3: Total de la compra -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTotalCompraFinal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#101725"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:strokeColor="#1E293B"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/rvDetalleCompraItems">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Total de la compra"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetalleTotalFinal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="S/ 150.00"
                    android:textColor="#F97316"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botones inferiores: Imprimir y Eliminar Compra -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/cardTotalCompraFinal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImprimirCompra"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:text="Imprimir"
                android:textAllCaps="false"
                android:textColor="#3B82F6"
                android:textSize="15sp"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_shopping_cart"
                app:iconGravity="textStart"
                app:iconTint="#3B82F6"
                app:strokeColor="#1E3A8A" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminarCompra"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Eliminar compra"
                android:textAllCaps="false"
                android:textColor="#EF4444"
                android:textSize="15sp"
                app:cornerRadius="14dp"
                app:strokeColor="#7F1D1D" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
