<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvDialogTitleVenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar Venta"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogSubtitleVenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ingresa los datos para registrar la venta"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Campo Pedido ID -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPedidoIdVenta"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/input_stroke_color">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPedidoIdVenta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ID del Pedido (ej: 1)"
                android:inputType="number"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Cliente ID -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilClienteIdVenta"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/input_stroke_color">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etClienteIdVenta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ID de Cliente (ej: 1)"
                android:inputType="number"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Total / Monto -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTotalVenta"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/input_stroke_color">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTotalVentaDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Monto Total (ej: 150.00)"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Método de Pago -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMetodoPagoVenta"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/input_stroke_color">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMetodoPagoVenta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Método de pago (Yape / Tarjeta / Efectivo)"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botones de Acción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarDialogVenta"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Cancelar"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarDialogVenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/blue_primary"
                android:text="Guardar"
                android:textColor="@color/white"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>