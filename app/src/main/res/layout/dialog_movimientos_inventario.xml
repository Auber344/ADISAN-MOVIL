<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#060A12"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/btnCerrarMovimientos"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:padding="6dp"
            android:rotation="180"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvTitleMovimientos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/btnCerrarMovimientos"
            android:text="Historial de movimientos"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Tarjeta del Producto -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#101725"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:strokeColor="#1E293B"
        app:strokeWidth="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardIconMovHeader"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerVertical="true"
                app:cardBackgroundColor="#0D2247"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="Producto"
                    android:src="@drawable/ic_box"
                    app:tint="#3B82F6" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toStartOf="@id/layoutStockActualHeader"
                android:layout_toEndOf="@id/cardIconMovHeader"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSubtitleMovimientos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cargando..."
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCategoriaMovimientos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="#0D2247"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="BEBIDAS"
                        android:textColor="#3B82F6"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMovIdProducto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ID: --"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutStockActualHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBadgeStockActual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#062E29"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Stock actual"
                    android:textColor="#10B981"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMovStockActualVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0 un."
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMovDesgloseStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 paq. + 0 un."
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Chips de Filtros -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipTodosMov"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#F97316"
                android:text="Todos"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipComprasMov"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#101725"
                android:text="Compras"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:strokeColor="#1E293B" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipVentasMov"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#101725"
                android:text="Ventas"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:strokeColor="#1E293B" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipAjustesMov"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#101725"
                android:text="Ajustes"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:strokeColor="#1E293B" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipReversionesMov"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="#101725"
                android:text="Reversiones"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:strokeColor="#1E293B" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Lista de Movimientos con ProgressBar y Estado Vacio -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="380dp">

        <ProgressBar
            android:id="@+id/pbLoadingMovimientos"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="#2563EB"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMovimientos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/tvSinMovimientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="No hay movimientos registrados"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
